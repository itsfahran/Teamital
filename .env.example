# Supabase (public, safe for the browser — protect data with RLS)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Site
NEXT_PUBLIC_SITE_URL=https://teamital.com
NEXT_PUBLIC_APP_URL=https://app.teamital.com
NEXT_PUBLIC_CONTACT_EMAIL=contact@teamital.com

# Server only — optional: email contact-form messages via Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=Teamital <noreply@example.com>

# Google Meet (Admin -> Availability -> Connect Google)
# Create an OAuth client (Web application) in Google Cloud, enable the Google Calendar API and add
#   <your-site>/api/google/callback  as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Server only (Supabase -> Project Settings -> API). Needed to store the Google token + booking event ids.
SUPABASE_SERVICE_ROLE_KEY=
